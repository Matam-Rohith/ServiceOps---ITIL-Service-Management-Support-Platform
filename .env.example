# ServiceOps Environment Configuration Template
# Copy to .env for local Docker Compose execution. Do NOT commit real secrets to source control.

# Database Credentials
POSTGRES_DB=serviceops_db
POSTGRES_USER=serviceops_user
POSTGRES_PASSWORD=serviceops_secure_pass
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/serviceops_db
SPRING_DATASOURCE_USERNAME=serviceops_user
SPRING_DATASOURCE_PASSWORD=serviceops_secure_pass

# Security & JWT Configuration (Must be at least 256 bits / 32 bytes hex)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Application Ports
BACKEND_PORT=8080
FRONTEND_PORT=3000
POSTGRES_PORT=5432
